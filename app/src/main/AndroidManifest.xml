<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- API 24-28: レガシーストレージへの書き込み用（実行時許可） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- API 30+: 全てのファイルアクセス（設定画面でユーザーが許可） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- アップデート確認: GitHub Releases の参照とAPKのダウンロードにのみ使う -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ダウンロードしたAPKのインストールを起動する（ユーザーが設定で許可する必要あり） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup="false" は API 31+ では端末間移行を止めないため、
         紐づけ（パスワード）と未送信キューは下の2つの除外ルールでも持ち出さないようにする -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StorageFiller">
        <!-- 紐づけ画面の「QRを読み取る」（Google Code Scanner）が使うスキャン画面のモジュールを、
             Play ストア経由のインストール時に事前取得させる。APKを手動で入れた場合は効かないので、
             初回はアプリ側（ChallengePanel.requestScannerModule）で取得を依頼する。
             スキャン画面は Google Play 開発者サービス側が出すため CAMERA 権限は追加しない。 -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- 回転・ダークモード切替・外付けキーボードで作り直さない。横向き用・夜間用のリソースは
             無いので並び直しだけで足りる。
             作り直すと、表示中のパネル・案内文・スキャン中の読み取り結果が失われる。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QRコード経由の初回設定。端末の標準カメラがこのスキームをデコードして開く。
                 autoVerifyは付けない（App Linksのドメイン検証はカスタムスキームには不要）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="storagefiller" android:host="setup" />
            </intent-filter>
            <!-- 上と同じ設定を https で運ぶ形。標準カメラの多くは http/https しか
                 「開く」候補を出さないため、QR自体はこちらを使う。
                 storagefiller.invalid は RFC 2606 で予約された、絶対に名前解決されない
                 TLD なので、誤ってブラウザで開かれても実在のどこかへ送られることはない。
                 autoVerifyは付けない（assetlinks.jsonをホストする実ドメインが要るため、
                 タップ1つを省くには見合わない。代わりにユーザーが「常に開く」を選べる
                 chooserが出る）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="storagefiller.invalid"
                    android:pathPrefix="/setup" />
            </intent-filter>
        </activity>

        <!-- ダウンロードしたAPKをインストーラーに content:// で渡すための provider -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
